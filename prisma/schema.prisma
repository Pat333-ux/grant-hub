generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_VERIFICATION
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model Member {
  id            String        @id @default(uuid())
  externalRef   String?       @unique
  publicKeyPem  String
  keyActive     Boolean       @default(true)
  keyRevokedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  applications  Application[]
  nonces        UsedNonce[]
}

model UsedNonce {
  memberId   String
  nonce      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, nonce])
  @@index([expiresAt])
}

model Grant {
  id               String        @id @default(uuid())
  code             String        @unique
  name             String
  jurisdiction     String        // e.g., "IN_FSSA", "VIGO_COUNTY", "FEDERAL"
  maxAwardCents    Int?
  rulesJson        Json          // Declarative eligibility ruleset
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  applications     Application[]
}

model Application {
  id               String            @id @default(uuid())
  requestId        String            @unique
  memberId         String
  grantId          String
  status           ApplicationStatus @default(SUBMITTED)
  matchScore       Int?
  diagnosticsJson  Json?
  payloadHash      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  member           Member            @relation(fields: [memberId], references: [id])
  grant            Grant             @relation(fields: [grantId], references: [id])

  @@index([memberId, createdAt])
  @@index([status])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  aggregateType  String       // e.g., "Application"
  aggregateId    String
  eventType      String       // e.g., "application.submitted"
  payloadJson    Json         // Keep routing/correlation + redacted/non-PII metadata
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  lockedAt       DateTime?
  lockedBy       String?
  availableAt    DateTime     @default(now())
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([lockedAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorType     String   // "MEMBER", "CASEWORKER", "ADMIN", "SYSTEM"
  actorId       String
  action        String
  resourceType  String
  resourceId    String
  metadataJson  Json?
  createdAt     DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}
