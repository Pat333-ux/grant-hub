PORT=3000
DATABASE_URL=postgresql://grant_hub:grant_hub_dev@127.0.0.1:5432/grant_hub?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
OUTBOUND_WEBHOOK_URL=https://example.com/webhooks/grant-events
# Replace both with independent, randomly generated secrets (at least 32 characters).
OUTBOUND_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GRANT_PROVIDER_WEBHOOK_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Configure the key-management adapter for the chosen deployment; never put private keys here.
KEY_PROVIDER=local
KEY_ID=replace-with-kms-key-reference
